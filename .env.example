# Скопируй в .env.local и заполни своими значениями.
# .env.local в .gitignore — в репозиторий он не попадёт.
# Эти переменные нужны только локальным скриптам (webhook, CLI).
# Сам бот на Cloudflare читает секреты из хранилища Cloudflare, а не отсюда.

# Токен от @BotFather
BOT_TOKEN=1234567890:AA...

# Username бота без @
BOT_USERNAME=your_bot

# Адрес задеплоенного Worker
WORKER_URL=https://tg-planner.your-subdomain.workers.dev

# Случайная строка, та же что в секрете Cloudflare WEBHOOK_SECRET
# Сгенерировать: node -e "console.log(crypto.randomUUID())"
WEBHOOK_SECRET=

# Случайная строка для HTTP API, та же что в секрете Cloudflare API_TOKEN
API_TOKEN=
